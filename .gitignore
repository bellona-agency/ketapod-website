# ── secrets ──────────────────────────────────────────────────────────────
# .env دارد کلید ادمین، JWT secret و رمز object storage. مقادیر نمونه در
# .env.example هستند و همان‌ها commit می‌شوند.
.env
.env.local
*.env.local
backend/.env
web/.env.local
pm-web/.env.local

# ── مواد داخلی ───────────────────────────────────────────────────────────
# مخزن عمومی است. اینها بیرون می‌مانند: پیچ‌دک، سند طراحی ورد، عکس‌های
# دست‌نویس دفترچه، و پوشه docs که اقتصاد واحد، تحلیل رقبا، نقد پیچ‌دک و
# دفتر ریسک در آن است. اگر روزی قرار شد منتشر شوند، باید تصمیم جداگانه‌ای
# باشد، نه اثر جانبی یک push.
docs/
*.pptx
*.docx
photo_*.jpg

# ── build output ─────────────────────────────────────────────────────────
node_modules/
web/.next/
web/out/
web/next-env.d.ts
pm-web/.next/
pm-web/out/
pm-web/next-env.d.ts
*.tsbuildinfo

# باینری‌های Go
backend/bin/
backend/api
backend/worker
backend/scheduler
backend/pmapi

# ...ولی `backend/api` بدون اسلش، پوشه را هم می‌گیرد — و `backend/api/`
# جای openapi.yaml است که سند ۰۷ آن را «تنها منبع حقیقت» می‌نامد و هر سه
# کلاینت از آن تولید می‌شوند. تا امروز بی‌صدا از گیت بیرون مانده بود.
# این خط برش می‌گرداند؛ الگوی بالا هنوز باینریِ کامپایل‌شده را می‌گیرد.
!backend/api/

# ── ابزار ─────────────────────────────────────────────────────────────────
.DS_Store
*.log
.idea/
.vscode/

# رمز basic auth دیپلوی
deploy/.env

# پکیج دیپلوی — بیلد است، نه کد
dist/
