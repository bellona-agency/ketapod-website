APP_ENV=development
HTTP_PORT=8080
PUBLIC_BASE_URL=http://localhost:8080

# پورت‌های میزبان برای docker compose. اگر Postgres یا Redis نصب‌شده با
# brew روی پورت پیش‌فرض گوش می‌دهد، اتصال محلی بی‌سروصدا به آن می‌رود نه
# به کانتینر. در آن حالت این‌ها را عوض کن (و DATABASE_URL/REDIS_ADDR را
# هم‌راستا کن) به‌جای متوقف کردن سرویس سیستمی.
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

DATABASE_URL=postgres://ketapod:ketapod@localhost:5432/ketapod?sslmode=disable

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

S3_ENDPOINT=localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ketapod-media
S3_ACCESS_KEY=ketapod
S3_SECRET_KEY=ketapod-secret
S3_USE_SSL=false

OTP_CODE_TTL=2m
OTP_CODE_LENGTH=5
OTP_MAX_ATTEMPTS=5

LOG_LEVEL=info

# پنل داخلی تولید محتوا. خالی یعنی فقط JWT با نقش admin. در production
# اگر ست شود باید حداقل ۳۲ کاراکتر باشد.
ADMIN_API_KEY=dev-admin-key

# سرویس AI همکار (OCR، پردازش متن، خلاصه، TTS، کتاب‌یار). حالا روی همین
# دیتابیس کار می‌کند؛ این آدرس فقط برای «شروع کن» است.
# {bookId} با شناسه ردیف public.books جایگزین می‌شود.
AI_SERVICE_BASE_URL=
AI_SERVICE_PROCESS_PATH=/api/v1/books/{bookId}/process
AI_SERVICE_API_KEY=
AI_SERVICE_TIMEOUT=30s
