# ── docker compose ───────────────────────────────────────────────────────
# فقط چیزهایی که بین محیط‌ها فرق می‌کنند. باقی تنظیمات بک‌اند در
# docker-compose.yml روی مقدارهای درست شبکه داکر ست شده‌اند.

# پورت‌های میزبان. اگر Postgres یا Redis روی خود مک هم بالاست، این‌ها را
# عوض کن تا اتصال محلی بی‌صدا سراغ سرویس سیستمی نرود.
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
HTTP_PORT=8080
WEB_PORT=3000

# پنل تولید محتوا. در production باید حداقل ۳۲ کاراکتر باشد.
ADMIN_API_KEY=dev-admin-key

# سرویس AI همکار. خالی یعنی آپلود کار می‌کند ولی تحویل کار با پیام روشن
# متوقف می‌ماند تا از پنل دوباره فرستاده شود.
AI_SERVICE_BASE_URL=
AI_SERVICE_PROCESS_PATH=/api/v1/books/{bookId}/process
AI_SERVICE_API_KEY=

# مرورگر این آدرس را صدا می‌زند، نه کانتینر وب — پس localhost درست است.
# داخل باندل کلاینت بیک می‌شود، یعنی تغییرش نیاز به build دوباره دارد.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# ── دروازه نسخه پیش‌نمایش ─────────────────────────────────────────────────
# خالی یعنی خاموش، و روی لپ‌تاپ باید خالی بماند.
#
# اگر مقدار بگیرد، کل سایت پشت یک رمز Basic می‌رود. این برای وقتی است که
# بیلد mock روی یک آدرس عمومی می‌نشیند: در این بیلد کد تأیید ورود در پاسخ
# خود API برمی‌گردد و صفحه ورود چاپش می‌کند، پس هر کسی که به سایت برسد
# می‌تواند با هر شماره‌ای وارد شود. تا وقتی درگاه پیامک واقعی وصل نشده،
# این تنها چیزی است که آن در را می‌بندد.
#
# عمداً NEXT_PUBLIC_ ندارد — آن پیشوند مقدار را داخل باندل مرورگر می‌برد.
PREVIEW_USER=ketapod
PREVIEW_PASSWORD=

# در production حتماً عوض شود.
JWT_SECRET=dev-only-insecure-secret-change-me
PUBLIC_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=*

# اگر build ایمیج بک‌اند وسط دانلود ماژول‌ها می‌شکند، پراکسی نزدیک‌تر:
# GOPROXY=https://goproxy.io,direct
# و همین برای npm اگر نصب وسط کار ECONNRESET می‌دهد:
# NPM_REGISTRY=https://registry.npmmirror.com

# ── ابزار داخلی مدیریت پروژه (profile: pm) ───────────────────────────────
# `docker compose --profile pm up -d --build`
PM_HTTP_PORT=8090
PM_WEB_PORT=3001

# باید با JWT_SECRET فرق کند. اگر یکی باشند، توکن یک شنونده کتاپاد اینجا
# هم پذیرفته می‌شود — claim فقط یک uuid است و نمی‌گوید از کدام جدول آمده.
# در production خالی‌بودنش باعث می‌شود سرویس بالا نیاید.
PM_JWT_SECRET=dev-only-insecure-pm-secret-change-me

# آدرس فرانت ابزار. لینک دعوت از روی همین ساخته می‌شود، پس باید مطلق باشد.
PM_APP_BASE_URL=http://localhost:3001
PM_CORS_ALLOWED_ORIGINS=*

# مرورگر این را صدا می‌زند. در باندل کلاینت بیک می‌شود.
NEXT_PUBLIC_PM_API_BASE_URL=http://localhost:8090

# اختیاری. بدون SMTP، لینک دعوت در پاسخ API برمی‌گردد تا مدیر خودش
# بفرستد — ابزار بدون ایمیل هم کامل کار می‌کند.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=کتاپاد
