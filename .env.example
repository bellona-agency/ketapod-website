# ── docker compose ───────────────────────────────────────────────────────
# فقط چیزهایی که بین محیط‌ها فرق می‌کنند. باقی تنظیمات بک‌اند در
# docker-compose.yml روی مقدارهای درست شبکه داکر ست شده‌اند.

# پورت‌های میزبان. اگر Postgres یا Redis روی خود مک هم بالاست، این‌ها را
# عوض کن تا اتصال محلی بی‌صدا سراغ سرویس سیستمی نرود.
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
HTTP_PORT=8080
WEB_PORT=3000

# پنل تولید محتوا. در production باید حداقل ۳۲ کاراکتر باشد.
ADMIN_API_KEY=dev-admin-key

# سرویس AI همکار. خالی یعنی آپلود کار می‌کند ولی تحویل کار با پیام روشن
# متوقف می‌ماند تا از پنل دوباره فرستاده شود.
AI_SERVICE_BASE_URL=
AI_SERVICE_PROCESS_PATH=/api/v1/books/{bookId}/process
AI_SERVICE_API_KEY=

# مرورگر این آدرس را صدا می‌زند، نه کانتینر وب — پس localhost درست است.
# داخل باندل کلاینت بیک می‌شود، یعنی تغییرش نیاز به build دوباره دارد.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# در production حتماً عوض شود.
JWT_SECRET=dev-only-insecure-secret-change-me
PUBLIC_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=*

# اگر build ایمیج بک‌اند وسط دانلود ماژول‌ها می‌شکند، پراکسی نزدیک‌تر:
# GOPROXY=https://goproxy.io,direct
# و همین برای npm اگر نصب وسط کار ECONNRESET می‌دهد:
# NPM_REGISTRY=https://registry.npmmirror.com
