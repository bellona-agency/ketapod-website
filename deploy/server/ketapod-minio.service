[Unit]
Description=Ketapod pm tool — object storage (MinIO, localhost only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ketapod-pm
Group=ketapod-pm
EnvironmentFile=__ENV__
# فقط روی لوکال‌هاست گوش می‌دهد — pmapi تنها مصرف‌کننده است، هیچ پورتی
# به بیرون باز نمی‌شود و به فایروال هم اضافه نمی‌شود.
ExecStart=__DIR__/minio server __DATADIR__ --address 127.0.0.1:9000 --console-address 127.0.0.1:9001

Restart=always
RestartSec=3
StartLimitBurst=5
StartLimitIntervalSec=60

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=__DATADIR__

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ketapod-minio

[Install]
WantedBy=multi-user.target
